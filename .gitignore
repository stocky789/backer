# ===========================================
# Backer Project .gitignore
# ===========================================

# ----- Python bytecode & cache -----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# ----- Build & distribution -----
build/
dist/
*.egg-info/
*.egg
.eggs/
wheels/
sdist/
develop-eggs/
.installed.cfg

# ----- Virtual environments -----
# Note: Use specific names to avoid conflicts with source directories
.venv/
venv/
env/
ENV/

# ----- IDE & editor files -----
.idea/
.vscode/
*.swp
*.swo
*~

# ----- Testing & linting -----
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ----- Backer runtime data -----
# Database files (runtime data, not source)
*.db
*.db-journal

# Local backer data directory
.backer/

# Agent log files
backer-agent-*.log

# ----- Documentation & notes -----
# Personal notes (not project docs)
claude.md

# ===========================================
# IMPORTANT: Do NOT add patterns that could
# match source files in src/backer/
# 
# Avoid patterns like:
#   - backer/     (matches src/backer/)
#   - Backer/     (case-insensitive match)
#   - *.py        (would exclude all Python!)
# ===========================================
