# ===========================================
# Backer Project .gitignore
# ===========================================

# ----- Python bytecode & cache -----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# ----- Build & distribution -----
build/
dist/
*.egg-info/
*.egg
.eggs/
wheels/
sdist/
develop-eggs/
.installed.cfg

# ----- Virtual environments -----
# Note: Use specific names to avoid conflicts with source directories
.venv/
venv/
env/
ENV/

# ----- IDE & editor files -----
.idea/
.vscode/
*.swp
*.swo
*~
.claude/
.fuse_hidden*

# ----- Testing & linting -----
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ----- Backer runtime data -----
# Database files (runtime data, not source)
*.db
*.db-journal

# Local backer data directory
.backer/

# Agent log files
backer-agent-*.log

# ----- Documentation & notes -----
# NOTE: do not ignore "claude.md" here. Git matches it case-insensitively on
# Windows and macOS, so it also swallows CLAUDE.md - the agent instruction
# file, which is project config and belongs in the repo alongside AGENTS.md,
# GEMINI.md and .cursor/rules/. Name personal scratch files something that
# cannot collide, e.g. notes-local.md, and ignore that instead.
notes-local.md
/serverless-backups.md

# ----- Agent & editor tooling -----
# Local code-index caches and per-machine assistant state. The shared rule
# files (CLAUDE.md, AGENTS.md, GEMINI.md, .cursor/rules/) are tracked.
.chunkhound/
.claude/settings.local.json
.aider*
.serena/

# ===========================================
# IMPORTANT: Do NOT add patterns that could
# match source files in src/backer/
# 
# Avoid patterns like:
#   - backer/     (matches src/backer/)
#   - Backer/     (case-insensitive match)
#   - *.py        (would exclude all Python!)
# ===========================================
