<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Backer.Desktop.ViewModels"
             x:Class="Backer.Desktop.Views.RestoreView"
             x:DataType="vm:RestoreViewModel">
  <ScrollViewer>
    <StackPanel Margin="32" MaxWidth="760" HorizontalAlignment="Left" Spacing="24">
      <StackPanel Spacing="8">
        <TextBlock Classes="title" Text="Restore files" />
        <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding StatusText}" />
      </StackPanel>

      <StackPanel Spacing="20" IsEnabled="{Binding !Busy}">
        <StackPanel Spacing="8">
          <TextBlock Text="Backup" />
          <ComboBox MinWidth="360" HorizontalAlignment="Stretch"
                    AutomationProperties.Name="Backup job"
                    ItemsSource="{Binding JobNames}" SelectedItem="{Binding SelectedJobName}" />
        </StackPanel>
        <StackPanel Spacing="8">
          <TextBlock Text="Backup version" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <ComboBox Grid.Column="0" HorizontalAlignment="Stretch"
                      AutomationProperties.Name="Backup version"
                      ItemsSource="{Binding Snapshots}" SelectedItem="{Binding SelectedSnapshot}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:SnapshotRow">
                  <StackPanel Orientation="Horizontal" Spacing="16">
                    <TextBlock Text="{Binding DisplayTime}" />
                    <TextBlock Classes="muted" Text="{Binding HumanSize}" />
                  </StackPanel>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Grid.Column="1" Content="Refresh" Command="{Binding LoadSnapshotsCommand}" />
          </Grid>
        </StackPanel>

        <StackPanel Spacing="16">
          <TextBlock Text="Restore to" />
          <StackPanel Spacing="6">
            <RadioButton GroupName="restoreTarget" Content="Original location"
                         IsChecked="{Binding RestoreOriginal}" />
            <TextBlock Margin="28,0,0,0" Text="{Binding OriginalLocation}" TextWrapping="Wrap" />
            <TextBlock Margin="28,0,0,0" Classes="muted" TextWrapping="Wrap"
                       Text="Matching files are replaced. Other files stay where they are." />
          </StackPanel>
          <StackPanel Spacing="8">
            <RadioButton GroupName="restoreTarget" Content="ZIP file in another folder"
                         IsChecked="{Binding SaveAsZip}" />
            <StackPanel Margin="28,0,0,0" Spacing="8" IsVisible="{Binding SaveAsZip}">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox Grid.Column="0" Text="{Binding Destination}" PlaceholderText="Choose a folder for the ZIP"
                         AutomationProperties.Name="ZIP destination folder" />
                <Button Grid.Column="1" Content="Choose folder" Command="{Binding ChooseDestinationCommand}" />
              </Grid>
              <TextBlock Classes="muted" TextWrapping="Wrap"
                         Text="Your original files stay untouched. The ZIP file is not encrypted." />
            </StackPanel>
          </StackPanel>
          <CheckBox IsVisible="{Binding ProtectedDestinationOffered}"
                    IsChecked="{Binding RestoreIntoProtectedFolder}"
                    Content="Restore into this protected folder anyway" />
        </StackPanel>
      </StackPanel>

      <ProgressBar IsIndeterminate="True" IsVisible="{Binding Busy}" />
      <WrapPanel Orientation="Horizontal">
        <Button Classes="primary" Margin="0,0,12,8" Content="{Binding RestoreAction}"
                Command="{Binding RestoreCommand}" IsEnabled="{Binding !Busy}" />
        <Button Margin="0,0,12,8" Content="Cancel" Command="{Binding StopCommand}" IsVisible="{Binding Restoring}" />
        <Button Margin="0,0,12,8" Content="Open folder" Command="{Binding OpenRestoredLocationCommand}"
                IsVisible="{Binding HasRestoredPath}" />
        <Button Margin="0,0,0,8" Content="Back" Command="{Binding BackCommand}" IsEnabled="{Binding !Busy}" />
      </WrapPanel>
      <Expander Header="Details" IsVisible="{Binding HasDetails}" IsExpanded="{Binding Failed}"
                HorizontalAlignment="Stretch">
        <StackPanel Spacing="8">
          <TextBox Classes="log" Text="{Binding Detail}" IsReadOnly="True" AcceptsReturn="True"
                   Height="120" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding Failed}">
            <Button Content="Copy error" Command="{Binding CopyErrorCommand}" />
            <Button Content="Open logs" Command="{Binding OpenLogFolderCommand}" />
          </StackPanel>
        </StackPanel>
      </Expander>
    </StackPanel>
  </ScrollViewer>
</UserControl>
