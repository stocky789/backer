<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Backer.Desktop.ViewModels"
             x:Class="Backer.Desktop.Views.EditJobView"
             x:DataType="vm:EditJobViewModel">
  <!-- Only the fields `backer job set` accepts. The source path is shown, not edited:
       changing it orphans the snapshots already taken against the old path. -->
  <DockPanel Margin="32" MaxWidth="560" HorizontalAlignment="Center">
    <StackPanel DockPanel.Dock="Top" Spacing="8">
      <TextBlock Classes="title" Text="{Binding Title}" />
      <TextBlock Classes="caption" Text="{Binding SourcePath, StringFormat='Backing up {0}'}" />
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,24,0,0">
      <Button Classes="primary" Content="Save changes" Command="{Binding SaveCommand}" IsEnabled="{Binding !Busy}" />
      <Button Content="Cancel" Command="{Binding CancelCommand}" />
      <TextBlock Classes="caption" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding StatusText}" />
    </StackPanel>

    <ScrollViewer Margin="0,24,0,0">
      <StackPanel Spacing="16">

        <StackPanel Spacing="6">
          <TextBlock Classes="section" Text="SCHEDULE" />
          <CheckBox Content="Back this job up on a schedule" IsChecked="{Binding !NoSchedule}" />
          <TextBox Text="{Binding Cron}" IsEnabled="{Binding !NoSchedule}" />
          <TextBlock Classes="caption" TextWrapping="Wrap"
                     Text="Five fields: minute hour day-of-month month day-of-week. &quot;0 2 * * *&quot; is every day at 2am." />
        </StackPanel>

        <StackPanel Spacing="6">
          <TextBlock Classes="section" Text="KEEP HOW MANY SNAPSHOTS" />
          <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="8">
            <TextBox Grid.Column="0" PlaceholderText="Last" Text="{Binding KeepLast}" />
            <TextBox Grid.Column="1" PlaceholderText="Daily" Text="{Binding KeepDaily}" />
            <TextBox Grid.Column="2" PlaceholderText="Weekly" Text="{Binding KeepWeekly}" />
            <TextBox Grid.Column="3" PlaceholderText="Monthly" Text="{Binding KeepMonthly}" />
            <TextBox Grid.Column="4" PlaceholderText="Yearly" Text="{Binding KeepYearly}" />
          </Grid>
        </StackPanel>

        <StackPanel Spacing="6">
          <TextBlock Classes="section" Text="LEAVE THESE OUT (ONE PATTERN PER LINE)" />
          <TextBox Classes="mono" AcceptsReturn="True" Height="110" TextWrapping="NoWrap" Text="{Binding Excludes}" />
        </StackPanel>

        <CheckBox Content="This job is switched on" IsChecked="{Binding Enabled}" />

      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
