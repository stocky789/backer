      <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="{StaticResource TextMutedColor}" />
      <SolidColorBrush x:Key="ButtonBorderBrush" Color="{StaticResource HairlineColor}" />
      <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="{StaticResource HairlineColor}" />
      <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="{StaticResource HairlineColor}" />
      <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="{StaticResource HairlineColor}" />

      <SolidColorBrush x:Key="TextControlBackground" Color="{StaticResource SurfaceColor}" />
      <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="{StaticResource SurfaceHoverColor}" />
      <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{StaticResource SurfaceColor}" />
      <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="{StaticResource BgBaseColor}" />
      <SolidColorBrush x:Key="TextControlBorderBrush" Color="{StaticResource HairlineColor}" />
      <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="{StaticResource HairlineColor}" />
      <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{StaticResource AccentColor}" />
