  </ResourceDictionary.ThemeDictionaries>

  <!-- Variant-independent: geometry and the spacing scale (4/8/12/16/24/32). -->
  <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
  <CornerRadius x:Key="OverlayCornerRadius">6</CornerRadius>
  <CornerRadius x:Key="CardCornerRadius">6</CornerRadius>
  <Thickness x:Key="ViewPadding">32</Thickness>
  <Thickness x:Key="CardPadding">16</Thickness>
  <x:Double x:Key="FormColumnWidth">560</x:Double>
  <x:Double x:Key="ControlContentThemeFontSize">13.5</x:Double>
</ResourceDictionary>
